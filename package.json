{
  "name": "net19",
  "version": "0.20.0",
  "private": true,
  "description": "Websites as they looked in 2019.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "pretest:browser": "playwright install chromium",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run package && npm run test:browser",
    "package": "node scripts/package.mjs",
    "audit": "node scripts/audit/live.mjs",
    "audit:diff": "node scripts/audit/diff.mjs",
    "audit:nav": "node --import tsx scripts/audit/nav.mjs",
    "audit:fit": "node scripts/audit/fit.mjs",
    "audit:inventory": "node scripts/audit/inventory.mjs",
    "audit:words": "node scripts/audit/words.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.1.12",
    "@types/node": "^24.0.0",
    "css-tree": "^3.2.1",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.3",
    "sharp": "^0.35.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
